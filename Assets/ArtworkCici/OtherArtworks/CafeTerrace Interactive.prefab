--- !u!114 &3509818285428762758
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2372824945646044838}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Van Gogh painted the caf\xE9 terrace on the Place du Forum in Arles in
    September 1888. He worked outdoors after dark, observing how artificial light
    changed the colours around him.\n\nThe yellow and orange glow of the caf\xE9
    stands against the blue sky and shadowed buildings. Instead of relying on black
    and grey, he filled the night with colour.\n\nLook closer: follow the tables
    and paving stones into the distance, then compare the warm terrace with the cool
    stars above.\n\nCollection source: Kr\xF6ller-M\xFCller Museum\nkrollermuller.nl
    \xB7 KM 108.565"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3b3e2ed9b7e13493988c908d708aead2, type: 2}
  m_sharedMaterial: {fileID: 4491145911956303112, guid: 3b3e2ed9b7e13493988c908d708aead2, type: 2}
