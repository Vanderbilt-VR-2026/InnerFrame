--- !u!114 &5652909749509936959
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2243285858237755571}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Van Gogh painted The Starry Night in Saint-R\xE9my in June 1889. The work
    brings together elements of the landscape he observed and an imagined arrangement
    of village, hills, and sky.\n\nThe village rests beneath a sky filled with sweeping
    curves. A dark cypress rises in the foreground, linking the land to the stars.\n\nBlue
    and yellow create strong contrasts, while repeated brushstrokes give the sky
    a sense of motion.\n\nLook closer: Follow the curves around the stars, then compare
    their movement with the quiet shapes of the houses."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3b3e2ed9b7e13493988c908d708aead2, type: 2}
  m_sharedMaterial: {fileID: 4491145911956303112, guid: 3b3e2ed9b7e13493988c908d708aead2, type: 2}
