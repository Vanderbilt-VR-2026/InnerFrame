--- !u!114 &2100813453
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2100813451}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Van Gogh painted Almond Blossom in Saint-R\xE9my-de-Provence in February
    1890, when his brother Theo and Jo had a son and named him Vincent. It was meant
    to hang over their bed.\n\nAlmond trees are among the first to flower each year,
    so the branches stand for new life. The strong outlines and the flat blue sky
    show what he learned from Japanese prints.\n\nLook closer: follow one branch
    from its thick, twisting base out to the buds at its tips.\n\nCollection: Van
    Gogh Museum, Amsterdam (Vincent van Gogh Foundation)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3b3e2ed9b7e13493988c908d708aead2, type: 2}
  m_sharedMaterial: {fileID: 4491145911956303112, guid: 3b3e2ed9b7e13493988c908d708aead2, type: 2}
