--- !u!114 &5166390867303253490
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8940325370756229771}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7039f01beca44e9985593f148aee061, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MirrorScene
  stages:
  - {fileID: 2800000, guid: 2193cacf79fce43958c49a1dfd1c9002, type: 3}
  - {fileID: 2800000, guid: f7fbe7e0eca6642d09d3d5bb766a8386, type: 3}
  - {fileID: 2800000, guid: aa6b27859ca1349789f3a45ba080dfb0, type: 3}
  lines:
  - id: greet
    text: Ah, come in! Mind the paint, it's still wet. Welcome to the yellow house.
    clip: {fileID: 8300000, guid: 334c44098fc504cf0af543f241e58378, type: 3}
  - id: explain
    text: I'm painting myself. I have no money for models, so I bought a good mirror
      and work from my own head.
    clip: {fileID: 8300000, guid: 34a92e814e7094769bbb375bea476648, type: 3}
  - id: ask
    text: Would you help me? Take the mirror from the wall, there by the towel, and
      hold it up for me.
    clip: {fileID: 8300000, guid: 35f6558221ca14bfbb0138c46a1aa27f, type: 3}
  - id: grab
    text: Yes, that one. Now hold it up beside my canvas, facing me.
    clip: {fileID: 8300000, guid: 7df6e3ad3289b487083667274c75986b, type: 3}
  - id: stage1
    text: If I can manage the colour of my own head, I'll be able to paint the heads
      of other fellows and women too.
    clip: {fileID: 8300000, guid: 433f47a5b20d84f1f893135f9c3634d9, type: 3}
  - id: stage2
    text: Now the colour. Hold still, my friend, this is the hard part.
    clip: {fileID: 8300000, guid: 935808ecd671b4f15950f4248c1bb696, type: 3}
  - id: back
    text: Bring the mirror back, my friend. I can't paint my face without it.
    clip: {fileID: 8300000, guid: 676e136393a8d481ba05d1523a27a351, type: 3}
  - id: done
    text: There, it's done. Thank you, my friend. Hang the mirror back for me; Gauguin
      will want to look at himself too.
    clip: {fileID: 8300000, guid: 8522585d28e4c4152b3bf79ec3f51631, type: 3}
